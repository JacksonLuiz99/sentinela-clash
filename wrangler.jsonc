{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clan-monitor",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CLAN_TAG": "#R0UPVVVY",
    "CLASH_API_BASE": "https://cocproxy.royaleapi.dev/v1",
    "PUBLIC_ORIGIN": "https://sentinela-clash.vercel.app",
    "DISCORD_PUBLIC_URL": "https://discord.gg/EmJeAWjBg",
    "TELEGRAM_PUBLIC_URL": "https://t.me/tigers_of_war4_alertas_bot",
    "ALERT_TYPES": "member_join,member_leave,war_start,war_end,war_reminder",
    "ALERT_CHANNELS": "telegram,discord"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "clan-monitor",
    "database_id": "9473f0f1-4611-46cb-9e8a-4f7423c2a53a",
    "migrations_dir": "migrations"
  }]
}
